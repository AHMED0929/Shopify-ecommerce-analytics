{
  "name": "Full-Funnel Executive Slate",
  "dataColors": [
    "#0F172A",
    "#2563EB",
    "#D97706",
    "#059669",
    "#64748B",
    "#7C3AED",
    "#DC2626",
    "#0891B2"
  ],
  "background": "#FFFFFF",
  "foreground": "#0F172A",
  "tableAccent": "#2563EB",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#0F172A"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 10,
      "color": "#0F172A"
    },
    "callout": {
      "fontFace": "Segoe UI Bold",
      "fontSize": 20,
      "color": "#0F172A"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#475569"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#F8FAFC" } },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E2E8F0" } },
            "radius": 6
          }
        ],
        "visualHeader": [
          {
            "background": { "solid": { "color": "#FFFFFF" } }
          }
        ]
      }
    }
  }
}